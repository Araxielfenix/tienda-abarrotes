# Configuración de entorno para Tienda de Abarrotes
# Copia este archivo a .env y rellena tus valores

# Puerto del servidor
PORT=3000

# API Key de SerpApi (obtener en https://serpapi.com)
# Regístrate gratis para obtener 100 búsquedas gratuitas al mes
SERPAPI_API_KEY=TU_API_KEY_DE_SERPAPI_AQUI

# Origen permitido para CORS (tu dominio de GitHub Pages)
CORS_ORIGIN=https://Araxielfenix.github.io